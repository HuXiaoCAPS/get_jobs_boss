# ============================================================
# Boss 投递配置（模板 / 示例）
# ------------------------------------------------------------
# 用法：复制本文件为同目录下的 boss.yaml，再按需修改。
#
#   程序读取顺序：
#     1) 存在 config/boss.yaml       → 用它（这是权威来源）
#     2) 不存在，但数据库里有旧配置  → 自动导出成 boss.yaml 再读
#     3) 都不存在                    → 用本模板的默认值
#
#   生效时机：每次点「开始投递」时重新读 → 改完重跑任务即生效，不用重启程序。
#
# ⚠️ boss.yaml 里含有 API KEY，已被 .gitignore 忽略；本模板不含任何密钥，
#    可以放心提交到仓库。
# ============================================================

# ---------- 管理页（可选）----------
# 程序启动后自动打开管理页时，用哪个浏览器：
#   msedge  = 优先 Microsoft Edge（默认；本项目的自动化本来就用 Edge）
#   default = 交给系统默认浏览器
#   其它    = 当作可执行文件路径直接用，例如
#             C:/Program Files/Google/Chrome/Application/chrome.exe
#   none    = 不自动打开，只把地址打进启动日志
# 注意：这里打开的是你日常那个浏览器（新开一个标签页）；自动化用的是独立的
#      browser-data/ profile，两者不共享登录态，不要当成同一个浏览器。
manage_page:
  browser: msedge

# ---------- 搜索条件 ----------
search:
  keywords: [数据开发, 数仓, 数据分析, 数据仓库]
  city: [不限]                        # 多城市写法：[深圳, 广州]；「不限」= 全国
  # 多城市的两种处理方式（Boss 的搜索一次只认一个城市，多城市只能二选一）：
  #   false / 不写 = 轮换模式：对 city 里的每个城市各搜一轮（原行为）
  #   true        = 过滤模式：搜索直接用全国码，再按岗位自身的城市筛选（命中才投）
  city_filter_mode: false
  # 排除的城市/省份：命中即跳过（轮换/过滤两种模式都生效）。
  # 填省份会自动展开成该省城市，例如 [广东] = 广州/深圳/东莞…，省得逐个枚举。
  # 分隔符支持全角逗号：写 "广东，东莞" 或 [广东, 东莞] 都行。
  city_exclude: []
  job_type: 实习                      # 不限 / 全职 / 兼职 / 实习
  experience: [在校生, 应届毕业生, 经验不限, 1年以下]
  degree: [本科]
  salary: [不限]
  scale: [不限]
  stage: [不限]
  industry: [不限]

# ---------- 投递行为 ----------
delivery:
  say_hi: |
    您好，我是XXX，……（不设会导致投递失败；AI 生成失败时也用它兜底）
  wait_time: 10                       # 岗位之间的停顿时长（秒），别设太小以免触发风控
  enable_ai: true                     # 由 AI 按 JD 生成打招呼语
  send_img_resume: false              # 需要把简历转成 resume.jpg 放到 src/main/resources/
  filter_dead_hr: true                # 过滤不活跃的 HR
  hr_active_max_days: 30              # HR 活跃度阈值（天）；0 = 关闭细粒度判定
  skip_delivered_company: true        # 同一家公司不重复投递（投过一家，其名下其它岗位都跳过）
  debugger: false                     # 调试模式：只遍历不投递

# ---------- AI ----------
ai:
  base_url: https://api.deepseek.com  # 只填到域名，不要带 /chat/completions（否则会被拼重复导致 404）
  api_key: sk-xxxx                    # 必填
  model: deepseek-flash
  introduce: |
    教育背景、项目经历……（会随每次请求一起发给模型，作为你的背景资料）
  prompt: |
    我目前在找实习工作，期望的岗位方向是数据/数仓开发等大数据相关职位。
    以下是我的个人介绍与项目经历：
    %s
    现在我在跟这个岗位打招呼：
    - 搜索关键词：%s
    - 岗位名称：%s
    - 岗位描述：
    %s
    以下是一段示例打招呼词（参考它的风格和篇幅，不要逐字照抄）：
    %s
    请结合该岗位的职位描述，生成一段针对性的中文打招呼语：突出与岗位最相关的技能和项目，
    篇幅与示例相近，直接输出招呼语正文，不要任何解释、标题或前缀。

# ---------- 通知（可选）----------
notify:
  hook_url: ""                        # 企业微信群机器人 webhook，留空则不推送
  bot_is_send: false
