# Database files
# 这里必须写 db/* 而不是目录级规则 db/：写成 db/ 时 git 不会进入该目录，
# 下面的 !db/.gitkeep 会失效 —— 结果就是 .gitkeep 推不上去，新人 clone 后没有
# db/ 目录，而 SQLite 不会自动建目录，jdbc:sqlite:./db/getjobs.db 会直接连不上库。
db/*
!db/.gitkeep
*.db

# Frontend build output
dist/

# Gradle cache
.gradle/
# 持久化浏览器用户数据（含登录态，绝对不能提交）
browser-data/

# 本地配置（含 API KEY，绝对不能提交；结构与模板见 config/boss.yaml.example）
# 用 config/*.yaml 而不是逐个列出：配置页可以新建任意多份配置（不同求职方向各一份），
# 每一份都可能被填进 API KEY，漏一个就会把它推到远端。
# JD 过滤规则也在配置文件里（jd_rules 段），所以它同样不会进仓库 ——
# 想让别人看到你的筛法，就把规则抄进 config/boss.yaml.example。
config/*.yaml
# 「当前生效的配置文件」指针，属于本机状态
config/.active

# Reasonix 会话与工具目录（本地）
.reasonix/

# 改造过程中的临时备份与一次性脚本（本地）
.obsolete/

# ============================================================
# 隐私与本地产物（审计补漏）
# ============================================================

# 内部改造笔记：含本机绝对路径（项目根、JDK 安装目录等），只留本地、不进仓库
# 与改造思路，只留本地，不进仓库
PLAN.md

# 运行日志：含 HR 姓名、公司、岗位等投递记录，不要外传
# （target/ 已覆盖 target/logs/，这里兜住散落在别处的日志）
*.log
logs/

# 打包 / 压缩 / 表格产物：源码仓库不需要，避免把「包」推上去
*.zip
*.xlsx
*.tar
*.tar.gz

# 环境变量文件（含密钥）
.env
.env.*
!.env.example

# 编辑器 / 工具留下的本地副本
*.local
*.bak
*.orig
*.rej
